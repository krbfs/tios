// Prisma models for TC26 2.0 (Next.js).
// Equivalent of Django models.py — stack is Next + Neon, not Django.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  admin
}

enum PsychotypeLevel {
  pure
  dyad
  triad
  complex
}

enum ContentMode {
  leader_resource
  insighter
  insighter_you
  stressless
  hr_table
}

enum ModeRequestStatus {
  pending
  approved
  rejected
}

enum TeamMemberRole {
  captain
  member
}

/// 1. User
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  @map("password_hash")
  role         UserRole @default(user)
  createdAt    DateTime @default(now()) @map("created_at")

  sessions TestSession[]
  consents UserConsent[]
  modeRequests ModeRequest[]
  teamsCreated Team[]
  teamMemberships TeamMember[]

  @@map("users")
}

/// 2. TestSession
model TestSession {
  id          String    @id @default(cuid())
  userId      String?   @map("user_id")
  sessionUuid String    @unique @default(uuid()) @map("session_uuid") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  results TestResult[]

  @@index([userId])
  @@map("test_sessions")
}

/// 3. TestResult
model TestResult {
  id                   String   @id @default(cuid())
  sessionId            String   @map("session_id")
  answers              Json     @db.JsonB
  scaledScores         Json?    @map("scaled_scores") @db.JsonB
  scaledSystemic       Json?    @map("scaled_systemic") @db.JsonB
  psychotypeCode       String   @map("psychotype_code")
  psychotypeSecondary  String?  @map("psychotype_secondary")
  /// sep_16 cascade: основной тип (код); при pure/triad часто = psychotype_code.
  primaryType          String?  @map("primary_type")
  secondaryType        String?  @map("secondary_type")
  profileComplexity    String?  @map("profile_complexity") @db.VarChar(24)
  cascadeLevelUsed     Int?     @map("cascade_level_used")
  clusterTendencies    Json?    @map("cluster_tendencies") @db.JsonB
  /// V1: `left` | `right` | `detected` (утверждённая триада).
  triadVariant         String?  @map("triad_variant") @db.VarChar(10)
  /// V1: Empath sub-index S (sensitivity side), range 0..12.
  subIndexS            Int?     @map("sub_index_s")
  /// V1: Empath sub-index N (normativity side), range 0..18.
  subIndexN            Int?     @map("sub_index_n")
  avgIntensity         Float?   @map("avg_intensity")
  validationWarnings   Json?    @map("validation_warnings") @db.JsonB
  mode                 ContentMode @default(leader_resource)
  adminComment         String?  @map("admin_comment")
  showAdminComment     Boolean  @default(false) @map("show_admin_comment")
  visibilityOverrides  Json?    @map("visibility_overrides") @db.JsonB
  isPublic             Boolean  @default(false) @map("is_public")
  shareToken           String?  @unique @map("share_token") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")

  session      TestSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  modeRequests ModeRequest[]
  teamEntries  TeamResultEntry[]

  @@index([sessionId])
  @@index([psychotypeCode])
  @@index([mode])
  @@map("test_results")
}

/// 4. ContentBlock
model ContentBlock {
  id               Int      @id @default(autoincrement())
  psychotypeCode   String   @map("psychotype_code")
  mode             ContentMode
  blockKey         String   @map("block_key")
  blockTemplate    String   @map("block_template")
  title            String?
  contentText      String   @map("content_text")
  sortOrder        Int      @default(0) @map("sort_order")
  isVisibleDefault Boolean  @default(true) @map("is_visible_default")
  version          Int      @default(1)
  isActive         Boolean  @default(true) @map("is_active")
  /// V1: NULL = base block; `left`/`right` = triad addition for that variant.
  triadVariant     String?  @map("triad_variant") @db.VarChar(10)
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([psychotypeCode, mode, blockKey, triadVariant, version])
  @@index([mode, psychotypeCode, isActive])
  @@index([psychotypeCode, mode, triadVariant])
  @@map("content_blocks")
}

/// 5. Question
model Question {
  id               Int     @id
  leftText         String  @map("left_text")
  rightText        String  @map("right_text")
  factorGroup      String  @map("factor_group")
  subFactor        String? @map("sub_factor")
  tendencyPositive String? @map("tendency_positive")
  tendencyNegative String? @map("tendency_negative")

  @@map("questions")
}

/// 6. PsychotypeDefinition
model PsychotypeDefinition {
  id        Int             @id @default(autoincrement())
  code      String          @unique
  nameRu    String          @map("name_ru")
  tendency1 String          @map("tendency_1")
  tendency2 String          @map("tendency_2")
  level     PsychotypeLevel @default(pure)
  isActive  Boolean         @default(true) @map("is_active")

  @@map("psychotype_definitions")
}

/// 7. ModeRequest — user requests to switch result content mode
model ModeRequest {
  id             String            @id @default(cuid())
  resultId       String            @map("result_id")
  userId         String?           @map("user_id")
  requestedMode  ContentMode       @map("requested_mode")
  status         ModeRequestStatus @default(pending)
  createdAt      DateTime          @default(now()) @map("created_at")
  resolvedAt     DateTime?         @map("resolved_at")
  resolvedById   String?           @map("resolved_by_id")
  adminNote      String?           @map("admin_note")

  result TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  user   User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([resultId])
  @@index([userId])
  @@index([status])
  @@map("mode_requests")
}

/// 9. CompatibilityRule — pairwise psychotype compatibility (8×8 matrix)
model CompatibilityRule {
  id                 Int     @id @default(autoincrement())
  typeACode          String  @map("type_a_code")
  typeBCode          String  @map("type_b_code")
  compatibilityLevel String  @map("compatibility_level")
  complementZone     String? @map("complement_zone")
  commonZone         String? @map("common_zone")
  intensityNote      String? @map("intensity_note")
  recommendation     String?

  @@unique([typeACode, typeBCode])
  @@index([typeACode])
  @@index([typeBCode])
  @@map("compatibility_rules")
}

/// 10. Team — group analysis up to 9 results (TZ §2.5, §6.8)
model Team {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  createdBy User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  members   TeamMember[]
  results   TeamResultEntry[]
  reports   TeamReport[]

  @@index([createdById])
  @@map("teams")
}

model TeamMember {
  id              String         @id @default(cuid())
  teamId          String         @map("team_id")
  userId          String?        @map("user_id")
  invitationEmail String?        @map("invitation_email")
  invitationToken String?        @unique @map("invitation_token") @db.Uuid
  joinedAt        DateTime?      @map("joined_at")
  role            TeamMemberRole @default(member)

  team Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamResultEntry {
  id       String   @id @default(cuid())
  teamId   String   @map("team_id")
  resultId String   @map("result_id")
  label    String?
  addedAt  DateTime @default(now()) @map("added_at")

  team   Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  result TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([teamId, resultId])
  @@index([teamId])
  @@index([resultId])
  @@map("team_result_entries")
}

model TeamReport {
  id                  String   @id @default(cuid())
  teamId              String   @map("team_id")
  compatibilityReport Json?    @map("compatibility_report") @db.JsonB
  leaderCandidates    Json?    @map("leader_candidates") @db.JsonB
  adminComment        String?  @map("admin_comment")
  showAdminComment    Boolean  @default(false) @map("show_admin_comment")
  visibilitySettings  Json?    @map("visibility_settings") @db.JsonB
  generatedAt         DateTime @default(now()) @map("generated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("team_results")
}

/// 8. UserConsent
model UserConsent {
  id             Int       @id @default(autoincrement())
  userId         String?   @map("user_id")
  sessionUuid    String?   @map("session_uuid") @db.Uuid
  consentVersion Int       @map("consent_version")
  consentText    String    @map("consent_text")
  consentedAt    DateTime  @default(now()) @map("consented_at")
  withdrawnAt    DateTime? @map("withdrawn_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionUuid])
  @@map("user_consents")
}

/// Antibot: blocked client IPs (populated by scripts/antibot-logs.py --block-auto).
model BlockedIp {
  id        String    @id @default(cuid())
  ip        String    @unique @db.VarChar(45)
  reason    String
  score     Int?
  source    String    @default("manual")
  blockedAt DateTime  @default(now()) @map("blocked_at")
  expiresAt DateTime? @map("expires_at")

  @@index([expiresAt])
  @@map("blocked_ips")
}
