{
  "name": "tc_26",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run chrome:assemble && next dev --turbopack",
    "build": "npm run chrome:assemble && next build",
    "start": "next start -p ${PORT:-8080}",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "playwright:install": "playwright install chromium",
    "test:mobile": "npm run playwright:install && tsx scripts/test-mobile-layout.ts",
    "test:mobile:all": "MOBILE_TEST_ALL=1 npm run test:mobile",
    "test:e2e-quiz": "npm run playwright:install && tsx scripts/test-e2e-quiz.ts",
    "test:e2e-quiz:all": "E2E_QUIZ_ALL=1 npm run test:e2e-quiz",
    "test:e2e-quiz:dev": "E2E_QUIZ_DEV=1 npm run test:e2e-quiz",
    "export:demo-pdf": "tsx scripts/export-demo-result-pdf.ts",
    "docker:build": "./scripts/docker-local.sh build",
    "docker:run": "./scripts/docker-local.sh run",
    "docker:up": "docker compose up --build",
    "gcp:setup": "python3 scripts/deploy.py --setup",
    "gcp:test": "python3 scripts/deploy.py --test",
    "gcp:deploy": "python3 scripts/deploy.py --deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:import-questions": "tsx scripts/import_questions.ts",
    "db:import-content": "tsx scripts/import_content.ts",
    "db:import-v1-content": "tsx scripts/import_content.ts -- data/v1_leader_resource_blocks.json",
    "db:import-insighter-you": "tsx scripts/import_insighter_you.ts",
    "db:import-insighter": "tsx scripts/import_insighter.ts",
    "db:import-stressless": "tsx scripts/import_stressless.ts",
    "db:import-hr-table": "tsx scripts/import_hr_table.ts",
    "db:import-all": "tsx scripts/import_all.ts",
    "db:seed-complex": "tsx scripts/seed_complex_psychotype.ts",
    "db:verify-content": "tsx scripts/verify_content_modes.ts",
    "verify:demo": "tsx scripts/verify_demo_encdata.ts",
    "validate:seo-a2a": "tsx scripts/validate_seo_a2a.ts",
    "logs:antibot": "python3 scripts/antibot-logs.py",
    "logs:antibot:block": "python3 scripts/antibot-logs.py --block-auto",
    "ips:block": "tsx scripts/block-ips.ts",
    "db:promote-admin": "tsx scripts/promote-admin.ts",
    "content:build-registry": "tsx scripts/build-content-registry.ts",
    "chrome:assemble": "tsx scripts/assemble-chrome.ts"
  },
  "postinstall": "node scripts/ensure-playwright.mjs",
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.8",
    "next": "15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "adm-zip": "^0.5.16",
    "eslint": "^9",
    "eslint-config-next": "15.2.4",
    "playwright": "^1.49.0",
    "prisma": "^6.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
