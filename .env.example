# GCP: tc-26 (370808572016)
PROJECT_ID=tc-26-504910
REGION=europe-west1
SERVICE=tc26
REPO=tc26
IMAGE=tc26
NODE_ENV=production
PORT=8080
NEXT_PUBLIC_SITE_URL=https://tc26-wppkmlz42a-ew.a.run.app

# Neon Postgres — взять в https://console.neon.tech → Project → Connect
#   DATABASE_URL = pooled connection
#   DIRECT_URL   = direct connection (для миграций)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# JWT_SECRET — придумываешь сам, это не ключ от внешнего сервиса:
#   openssl rand -base64 48
# Локально: положить в .env (файл в gitignore). На деплое: Cloud Run → Variables.
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h
