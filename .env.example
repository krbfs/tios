# GCP: tc-26 (370808572016)
PROJECT_ID=tc-26-504910
REGION=europe-west1
SERVICE=tc26
REPO=tc26
IMAGE=tc26
NODE_ENV=production
PORT=8080
NEXT_PUBLIC_SITE_URL=https://tios-test.com
# Canonical public URL (baked into Docker build). See deploy/DOMAIN.md for DNS setup.

# Google Analytics 4 — client-side (gtag on site, public in browser bundle)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-TYYGE7DS6E
NEXT_PUBLIC_GA_ENABLED=true

# Yandex.Metrika — client-side counter (public in browser bundle)
NEXT_PUBLIC_YANDEX_METRIKA_ID=111930448
NEXT_PUBLIC_YANDEX_METRIKA_ENABLED=true

# Google Analytics 4 Data API — server reports / exports (keep secret)
# Property ID: GA4 → Admin → Property settings (numeric, not G-XXXX)
GA4_PROPERTY_ID=
# Add in GA4 → Admin → Property access management → Viewer
GA4_SERVICE_ACCOUNT_EMAIL=tc26service@tc-26-504910.iam.gserviceaccount.com
# Cloud Run: deploy.py sends minified JSON to GA4_SERVICE_ACCOUNT_JSON env var.
# Option A — paste minified JSON in one line:
GA4_SERVICE_ACCOUNT_JSON=
# Option B — path to key file (deploy reads it, pushes JSON to Cloud Run):
GA4_SERVICE_ACCOUNT_JSON_FILE=secrets/ga4-service-account.json
# Local dev only (Node reads file directly; not synced to Cloud Run):
GOOGLE_APPLICATION_CREDENTIALS=secrets/ga4-service-account.json

# Neon Postgres — взять в https://console.neon.tech → Project → Connect
#   DATABASE_URL = pooled connection
#   DIRECT_URL   = direct connection (для миграций)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# JWT_SECRET — придумываешь сам, это не ключ от внешнего сервиса:
#   openssl rand -base64 48
# Локально: положить в .env (файл в gitignore). На деплое: Cloud Run → Variables.
# Также подписывает публичные encdata-ссылки на результат (анти-oracle).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=24h

# Feature flag: V1 profiles (triad_variant + complex instead of mixed).
TIOS_V1_PROFILES=true

# Telegram — форма «Свяжитесь с нами» (/contact)
# Bot: @BotFather → token; chat_id: ваш ID или ID группы
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
